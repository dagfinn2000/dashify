# Copy this file to .env and fill in your secrets.
# docker compose loads it into the container; reference values in config.yaml
# as ${VAR}, e.g.  key: "${PIHOLE_PASSWORD}"
#
# .env is gitignored, so your secrets never end up on GitHub.

PIHOLE_PASSWORD=your-pihole-app-password
NPM_PASSWORD=your-nginx-proxy-manager-password
# PORTAINER_TOKEN=your-portainer-api-token
